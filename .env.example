# Pick ONE model provider. Lore uses the first key it finds, in this order.
# DigitalOcean Serverless Inference model access key (preferred)
DO_MODEL_KEY=
# Free-tier fallbacks that serve open-weight models (no card needed at the time of writing)
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
# Google AI Studio key (aistudio.google.com, free, no billing); Lore uses open-weight Gemma only
GEMINI_API_KEY=
# Google Cloud Vertex AI: project id + `gcloud auth login` (no key)
VERTEX_PROJECT=
VERTEX_REGION=global
VERTEX_ACCOUNT=
# Or force one: digitalocean | groq | cerebras | openrouter | google | vertex | ollama
LORE_PROVIDER=
# Optional: pin an open-weight model id from `python -m lore models`
LORE_MODEL=
# Optional: parallel model calls (lower to 2 if you hit rate limits)
LORE_WORKERS=
# Optional: GitHub token (falls back to `gh auth token`)
GITHUB_TOKEN=
